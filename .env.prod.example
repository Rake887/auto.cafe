# Продакшн-настройки. Скопируйте в .env.prod и заполните.
# Файл содержит пароли — в git он не попадает (см. .gitignore).

# --- Домен ---
# A-запись домена должна указывать на IP вашего VPS
SITE_DOMAIN=menu.example.kz
# Почта для Let's Encrypt: туда придёт письмо, если сертификат не продлится
ACME_EMAIL=you@example.kz

# --- База данных ---
POSTGRES_USER=qrmenu
# Смените: этот пароль защищает всю выручку заведения
POSTGRES_PASSWORD=
POSTGRES_DB=qrmenu

# --- Telegram ---
BOT_TOKEN=
# Любая длинная случайная строка: ей Telegram подписывает запросы к вебхуку
WEBHOOK_SECRET=
# chat_id группы заведения (у групп он отрицательный)
GROUP_CHAT_ID=
# Через сколько минут напомнить о непринятом заказе, 0 — выключить
ORDER_REMINDER_MINUTES=5
# Через сколько секунд непринятый вызов официанта считается просроченным
# и бот дёргает чат повторно. 0 — эскалация выключена.
SERVICE_CALL_SLA_SECONDS=90

# --- Админка ---
# Машинный ключ для скриптов. Владелец входит логином и паролем:
#   docker compose -f docker-compose.prod.yml exec api python -m app.create_admin
ADMIN_TOKEN=

# --- Прочее ---
DEMO_ORGANIZATION_ID=1
# Часовой пояс заведения: от него считается «час пик» в статистике
DISPLAY_TIMEZONE=Asia/Almaty
