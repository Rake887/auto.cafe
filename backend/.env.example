# --- База данных ---
# Для локального запуска (postgres в docker, api на хосте):
DATABASE_URL=postgresql+asyncpg://qrmenu:qrmenu@localhost:55433/qrmenu
# Внутри docker-compose переменная переопределяется на host=db (см. docker-compose.yml)

# --- Telegram-бот ---
# Токен от @BotFather. Пустой = бот выключен, заказы создаются без уведомлений.
BOT_TOKEN=
# Публичный HTTPS-адрес API (ngrok / cloudflared / VPS), БЕЗ хвостового слэша.
# При старте приложение само вызовет setWebhook на {WEBHOOK_URL}/telegram/webhook
WEBHOOK_URL=
# Секрет для проверки, что вебхук дёргает именно Telegram (любая случайная строка)
WEBHOOK_SECRET=change-me
# chat_id общего чата заведения (группа, куда падают заказы).
# Добавь бота в группу и узнай id, например, через @getidsbot (у групп id отрицательный)
GROUP_CHAT_ID=0

# --- Демо-режим ---
# Захардкоженная организация для демо (создаётся сидингом)
DEMO_ORGANIZATION_ID=1

# --- CORS ---
# Origin фронтенда; * — для локальной разработки
CORS_ORIGINS=*

# --- Демо ---
# Если задан, сидинг выдаст этот токен «Столу 1» (удобно для демо-ссылки).
# Для реального заведения оставить пустым — токены должны быть случайными.
DEMO_TOKEN=demo
