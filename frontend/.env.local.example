# Пусто/не задано — фронт работает на мок-данных из src/lib/mock.ts.
# Указано — запросы идут в реальный FastAPI.
NEXT_PUBLIC_API_BASE=http://localhost:8010

# Токен стола для кнопки «Открыть демо-меню» на служебной странице «/».
# Возьмите любой из вывода `python -m app.seed` в папке backend.
# В мок-режиме подходит любое значение, кроме "invalid".
NEXT_PUBLIC_DEMO_TOKEN=demo
