# Конфигурация всего стека (docker compose в корне проекта).
# Скопируйте в .env: cp .env.example .env

# --- Порты на хосте ---
WEB_PORT=3000        # гостевой фронтенд
API_PORT=8010        # FastAPI (внутри контейнера всегда 8000)
DB_PORT=55433        # Postgres (5432 на машине обычно занят)

# --- База данных ---
POSTGRES_USER=qrmenu
POSTGRES_PASSWORD=qrmenu
POSTGRES_DB=qrmenu

# --- Фронтенд ---
# Адрес API для БРАУЗЕРА гостя. Вшивается в бандл при сборке образа web,
# поэтому после изменения нужен `docker compose build web`.
# Для показа с телефона поставьте IP машины в сети: http://192.168.0.10:8010
PUBLIC_API_BASE=/api
# Токен стола для кнопки «Открыть демо-меню» на служебной странице «/».
# Возьмите из вывода сидинга.
DEMO_TOKEN=demo

# --- Telegram-бот ---
# Пустой BOT_TOKEN = бот выключен: API и фронтенд работают, уведомления не уходят.
BOT_TOKEN=
# Публичный HTTPS-адрес API без хвостового слэша. Берётся из логов туннеля:
#   docker compose --profile tunnel-cf up -d cloudflared
#   docker compose logs cloudflared | grep trycloudflare.com
# и добавить к нему /api
WEBHOOK_URL=
# Любая случайная строка: ей Telegram подписывает запросы к вебхуку
WEBHOOK_SECRET=change-me
# chat_id группы заведения (у групп он отрицательный). Добавьте бота в группу —
# он сам напишет туда свой chat_id, или отправьте в чат /chatid
# Через сколько минут бот напомнит в чат о заказе, который никто не принял.
# 0 — напоминания выключены.
ORDER_REMINDER_MINUTES=5
# Через сколько секунд непринятый вызов официанта считается просроченным
# и бот дёргает чат повторно. 0 — эскалация выключена.
SERVICE_CALL_SLA_SECONDS=90
GROUP_CHAT_ID=0
# Получать обновления опросом вместо вебхука. На локальном стенде нужно:
# Telegram блокирует адреса *.trycloudflare.com, и вебхук туда не встаёт —
# кнопки в чате молча перестают работать. На своём домене ставьте 0.
BOT_POLLING=1


# --- Демо ---
DEMO_ORGANIZATION_ID=1
CORS_ORIGINS=*

# --- Админ-панель ---
# Ключ к странице статистики: /admin/<ключ>. Пустой — раздел выключен (404).
ADMIN_TOKEN=смените-на-свой-секрет
