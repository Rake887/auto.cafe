# Единая точка входа: меню и API на одном origin.
# Благодаря этому фронтенду не нужно знать внешний адрес — он ходит в API
# по относительному пути /api, который одинаково работает на localhost,
# в локальной сети и через любой туннель. И CORS не нужен.
:80 {
	# /api/m/demo -> api:8000/m/demo (префикс срезается)
	handle_path /api/* {
		reverse_proxy api:8000
	}

	# всё остальное — гостевой фронтенд
	handle {
		reverse_proxy web:3000
	}
}
